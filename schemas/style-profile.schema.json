{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persona-library.dev/schemas/style-profile.schema.json",
  "title": "StyleProfile",
  "description": "The machine-parseable style description of a persona.",
  "type": "object",
  "properties": {
    "voice_summary": { "type": "string" },
    "tone": {
      "type": "object",
      "properties": {
        "formality": { "type": "number", "minimum": 0, "maximum": 1 },
        "warmth": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "humor": { "type": "number", "minimum": 0, "maximum": 1 },
        "emotional_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "directness": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["formality", "warmth", "confidence", "humor", "emotional_intensity", "directness"],
      "additionalProperties": false
    },
    "sentence_patterns": { "type": "array", "items": { "type": "string" } },
    "paragraph_patterns": { "type": "array", "items": { "type": "string" } },
    "rhetorical_patterns": { "type": "array", "items": { "type": "string" } },
    "preferred_vocabulary": { "type": "array", "items": { "type": "string" } },
    "avoided_vocabulary": { "type": "array", "items": { "type": "string" } },
    "signature_moves": { "type": "array", "items": { "type": "string" } },
    "anti_patterns": { "type": "array", "items": { "type": "string" } },
    "positive_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": ["string", "null"] },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    "negative_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": ["string", "null"] },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    }
  },
  "required": ["tone"],
  "additionalProperties": false
}
