{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persona-library.dev/schemas/persona.schema.json",
  "title": "Persona",
  "description": "A full writing persona: metadata + style profile + runtime rules.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 200 },
    "category": { "type": "string", "minLength": 1 },
    "languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "emoji": { "type": ["string", "null"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source_type": {
      "enum": ["archetype", "user-created", "sample-derived", "brand", "inspired"]
    },
    "style_strength_default": { "type": "number", "minimum": 0, "maximum": 1 },
    "disclaimer": { "type": ["string", "null"] },
    "path": { "type": ["string", "null"] },
    "profile": { "$ref": "style-profile.schema.json" },
    "content_preservation_rules": { "type": "array", "items": { "type": "string" } },
    "transformation_rules": { "type": "array", "items": { "type": "string" } },
    "body_markdown": { "type": "string" }
  },
  "required": ["id", "name", "category", "source_type", "profile"],
  "additionalProperties": false
}
